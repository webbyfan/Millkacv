# MongoDB connection URI
MONGODB_URI=mongodb://localhost:27017/resume_builder

# Optional email settings (for contact form forwarding)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_NOTIFY_EMAIL=you@example.com

# Server port
PORT=4000

# Postgres + Prisma
# Example: postgresql://user:password@localhost:5432/resume_builder?schema=public
DATABASE_URL=

# JWT secret for signing auth tokens
JWT_SECRET=replace_this_with_a_strong_secret

# Optional seed admin credentials
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123

# Google Gemini API key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
