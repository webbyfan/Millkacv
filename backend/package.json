{
  "name": "resume-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --exec node --experimental-specifier-resolution=node -r dotenv/config src/index.js",
    "start": "node --experimental-specifier-resolution=node -r dotenv/config src/index.js",
    "seed": "node --experimental-specifier-resolution=node -r dotenv/config src/seed.js",
    "seed:auth": "node --experimental-specifier-resolution=node -r dotenv/config src/seed-auth.js",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@prisma/client": "^5.0.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.1.4",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.0.1",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^6.10.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.4",
    "pino": "^8.14.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
